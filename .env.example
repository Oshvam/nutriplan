# Copia a .env y rellena. Nunca se sube al servidor (el deploy lo excluye).
APP_URL="http://localhost:8000"
APP_ENV="dev"

GOOGLE_CLIENT_ID=""

MISTRAL_API_KEY=""

DB_HOST="localhost"
DB_NAME="nutriplan"
DB_USER="nutriplan"
DB_PASS=""

# Push propias (VAPID). Vacías: se autogeneran y guardan en la tabla settings.
# VAPID_SUBJECT debe ser https: o mailto: válido.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"

# Actualizaciones desde GitHub (releases). Vacío = desactivado.
# GITHUB_REPO="usuario/nutriplan-php"
