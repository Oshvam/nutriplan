{% extends "layout.twig" %}
{% block title %}Generar con IA · NutriPlan{% endblock %}
{% block body %}
<main class="max-w-7xl mx-auto px-4 py-4 space-y-4">
  <h1 class="text-xl font-bold flex items-center gap-2"><i data-lucide="sparkles" class="h-5 w-5"></i> Recetas con IA {{ mistral.configured ? '' : '(modo local)' }}</h1>
  {% if not mistral.configured %}
    <p class="text-xs text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950 rounded-xl px-3 py-2">Sin clave de Mistral: se usarán recetas de respaldo. <a href="/perfil#ajustes" class="underline">Configúrala aquí</a>.</p>
  {% endif %}
  <div class="rounded-2xl bg-white dark:bg-slate-900 shadow-sm p-4 space-y-3 text-sm">
    <div class="flex gap-2 items-center flex-wrap">
      <label>Antojo o idea <input type="text" id="ia-craving" placeholder="algo con pollo y limón…" class="rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent p-2 w-64" /></label>
      <label>Tiempo
        <select id="ia-time" class="rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent p-2">
          <option value="15">15 min</option><option value="25" selected>25 min</option><option value="45">45 min</option>
        </select>
      </label>
      <button id="ia-go" class="px-4 py-2 rounded-full bg-violet-600 text-white font-bold">Generar</button>
    </div>
    <p id="ia-msg" class="text-xs text-slate-500"></p>
    <div id="ia-results" class="space-y-3"></div>
  </div>
  <script id="px" type="application/json">{{ profile|json_encode|replace({'</':'<\\/'})|raw }}</script>
  <script id="nx" type="application/json">{{ needs|json_encode|raw }}</script>
  <script>
    window.__IACTX = { dia: {{ dia is not null ? dia : 'null' }}, slot: {{ slot ? ('"' ~ slot ~ '"') : 'null' }} };
  </script>
</main>
{% endblock %}
